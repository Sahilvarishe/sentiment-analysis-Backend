# ==============================================================================
# Environment Configuration Template for Flask Backend
# ==============================================================================

# Flask Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True
FLASK_SECRET_KEY=your_secret_key_here

# CORS Configuration (Allowed origins)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mindpulse
MONGODB_DATABASE=mindpulse
MONGODB_COLLECTION=emotion_history

# CNN Model Settings (placed inside backend/models/)
MODEL_FILENAME=resnet50_emotion_best.keras
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224
MODEL_INPUT_CHANNELS=3

# Google YouTube Data API v3 Key
# Replace with your actual key from Google Cloud Console
YOUTUBE_API_KEY=YOUR_API_KEY_HERE

# Number of recommended songs to return
DEFAULT_MAX_RECOMMENDATIONS=6
